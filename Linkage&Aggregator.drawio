        </mxCell>
        <mxCell id="dtl_o" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;align=center;fontSize=11;" value="&lt;b&gt;RDH_TRADE_LINEAGE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Lookup and write target. All steps read or write here.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="1150" y="200" as="geometry" />
        </mxCell>
        <mxCell id="dps_o" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;align=center;fontSize=11;" value="&lt;b&gt;RDH_PERSISTENCE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Written on PF and NRPT events only. MIFID_STATUS = PENDING.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="190" x="1155" y="370" as="geometry" />
        </mxCell>
        <mxCell id="brd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=1 2;fontColor=#666666;labelBackgroundColor=none;align=left;verticalAlign=top;fontStyle=1;fontSize=12;" value="Stage 2 — Trade Linkage  (RDH Component)" vertex="1">
          <mxGeometry height="1090" width="880" x="240" y="140" as="geometry" />
        </mxCell>
        <mxCell id="s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#78A8D8;fontSize=11;" value="&lt;b&gt;Step 0  Replay Detection&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;SELECT * FROM RDH_TRADE_LINEAGE WHERE MESSAGE_ID = [incoming] AND REGIME = MIFID&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="340" x="397.5" y="205" as="geometry" />
        </mxCell>
        <mxCell id="d0" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="Replay found?" vertex="1">
          <mxGeometry height="80" width="130" x="502.5" y="340" as="geometry" />
        </mxCell>
        <mxCell id="s0a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 0-A  Replay Detected&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component] · Kear call confirmed&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new row → RDH_TRADE_LINEAGE:&lt;br/&gt;  Same MIFID_LINK_ID + TRN carried forward.&lt;br/&gt;  REPLAY_FLAG = Y · New MESSAGE_ID · New timestamp.&lt;br/&gt;INSERT new row → RDH_PERSISTENCE:&lt;br/&gt;  Carry forward existing persisted values.&lt;br/&gt;Skip Steps 1.0 → 2.0. Audit trail preserved.&lt;/font&gt;" vertex="1">
          <mxGeometry height="135" width="330" x="710" y="330" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#78A8D8;fontSize=11;" value="&lt;b&gt;Step 1.0  CONTRACT_ID Lookup&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;SELECT MIFID_LINK_ID, MIFID_TRANSACTION_ID, IS_NRPT FROM RDH_TRADE_LINEAGE WHERE MX_CONTRACT_ID = [json] AND REGIME = MIFID ORDER BY CREATED_TIMESTAMP DESC LIMIT 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="400" y="480" as="geometry" />
        </mxCell>
        <mxCell id="d10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="CONTRACT_ID match?" vertex="1">
