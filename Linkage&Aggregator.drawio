        <mxCell id="e12d12" edge="1" parent="1" source="s12" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#707070;strokeWidth=2;fontColor=#707070;fontSize=10;exitX=0.453;exitY=1.029;exitDx=0;exitDy=0;exitPerimeter=0;" target="d12" value="">
