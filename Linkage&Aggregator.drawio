        <mxCell id="vOGihw5DsFz4zbwunT8B-20" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#000000;strokeColor=#b85450;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ FAIL (warning)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Trade already submitted and previously cancelled.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="900" y="290" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-21" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev PENDING and&lt;br/&gt;not SENT?" vertex="1">
          <mxGeometry height="90" width="170" x="690" y="500" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-22" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#000000;strokeColor=#82b366;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ Override to NEWT&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;PENDING. Override prev PENDING to OBSOLETE.&lt;br/&gt;Never SENT before — no NEWT reported previously, so this latest version is tagged NEWT.&lt;br/&gt;&lt;i&gt;⚡ Also handles out-of-sequence case where REPL arrives before original NEWT is sent — override to NEWT confirmed in team call.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="300" x="900" y="450" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-23" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev OBSOLETE and&lt;br/&gt;not SENT?" vertex="1">
          <mxGeometry height="90" width="170" x="690" y="710" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-24" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#555555;strokeColor=#999999;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ OBSOLETE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Retain REPL action. Create new record.&lt;br/&gt;Set to OBSOLETE previously (potential CANC) — Correction also OBSOLETE.&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="900" y="670" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-25" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev FAIL and&lt;br/&gt;not SENT?" vertex="1">
