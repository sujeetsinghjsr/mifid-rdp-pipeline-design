        <mxCell id="vOGihw5DsFz4zbwunT8B-27" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#333333;strokeColor=#d6b656;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ Override to NEWT — first instance&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;No previous history for this TRN. Override REPL to NEWT and treat as first instance.&lt;br/&gt;&lt;i&gt;⚡ Confirmed in team call: preferable to failing the record. Same principle as PENDING+REPL→NEWT rule above.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="640" x="690" y="1030" as="geometry" />
