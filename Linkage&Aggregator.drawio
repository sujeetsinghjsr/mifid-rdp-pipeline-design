        <mxCell id="vOGihw5DsFz4zbwunT8B-26" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#000000;strokeColor=#b85450;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ FAIL (warning)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Trade currently in FAIL status. Create new record.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="900" y="870" as="geometry" />
