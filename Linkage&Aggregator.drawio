        <mxCell id="s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;fontSize=11;" value="&lt;b&gt;Step 0  Replay Detection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;SELECT * FROM RDH_TRADE_LINEAGE WHERE MESSAGE_ID = [incoming] AND REGIME = MIFID&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="340" x="397.5" y="205" as="geometry" />
        </mxCell>
        <mxCell id="d0" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="Replay found?" vertex="1">
          <mxGeometry height="80" width="130" x="502.5" y="340" as="geometry" />
        </mxCell>
        <mxCell id="s0a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 0-A  Replay Detected&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component] · Kear confirmed (Kear call)&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new row into RDH_TRADE_LINEAGE:&lt;br/&gt;  Same MIFID_LINK_ID, same TRN, same PARENT_LINK_ID&lt;br/&gt;  Set REPLAY_FLAG = Y · New MESSAGE_ID · New timestamp&lt;br/&gt;INSERT new row into RDH_PERSISTENCE (carry values).&lt;br/&gt;Skip Steps 1.0 → 2.0. Audit trail preserved.&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="737.5" y="315" as="geometry" />
        </mxCell>
        <mxCell id="s10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;fontSize=11;" value="&lt;b&gt;Step 1.0  CONTRACT_ID Lookup&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;SELECT MIFID_LINK_ID, MIFID_TRANSACTION_ID, IS_NRPT FROM RDH_TRADE_LINEAGE WHERE MX_CONTRACT_ID = [json] AND REGIME = MIFID ORDER BY CREATED_TIMESTAMP DESC LIMIT 1&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="400" y="480" as="geometry" />
        </mxCell>
        <mxCell id="d10" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="CONTRACT_ID match?" vertex="1">
          <mxGeometry height="80" width="140" x="500" y="625" as="geometry" />
        </mxCell>
        <mxCell id="d11" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="Event category?" vertex="1">
          <mxGeometry height="80" width="130" x="240" y="760" as="geometry" />
        </mxCell>
        <mxCell id="s111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 1.1.1  NPF Carry Forward&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component] · Kear confirmed&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new row → RDH_TRADE_LINEAGE:&lt;br/&gt;  Same MIFID_LINK_ID + PARENT_LINK_ID (carried)&lt;br/&gt;  Updated: event label, MESSAGE_ID, timestamp&lt;br/&gt;INSERT new row → RDH_PERSISTENCE:&lt;br/&gt;  Carry forward all existing persisted values&lt;br/&gt;TRN: unchanged. MIFID_ACTION: NULL.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="220" x="340" y="910" as="geometry" />
        </mxCell>
        <mxCell id="s112" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 1.1.2  PF / NRPT New Link&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component] · Kear confirmed&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new row → RDH_TRADE_LINEAGE:&lt;br/&gt;  New MIFID_LINK_ID (UUID). PARENT = previous.&lt;br/&gt;  TRN = MX_TRADE_NB + V + MX_VERSION.&lt;br/&gt;  IS_NRPT = Y if NRPT. MIFID_ACTION = NULL.&lt;br/&gt;INSERT new row → RDH_PERSISTENCE:&lt;br/&gt;  Carry persistence values + new status.&lt;br/&gt;  MIFID_STATUS = PENDING (or SUPPRESSED if IS_NRPT=Y).&lt;/font&gt;" vertex="1">
          <mxGeometry height="132.5" width="270" x="450" y="727.5" as="geometry" />
        </mxCell>
        <mxCell id="s12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#000000;align=center;arcSize=10;strokeColor=#78A8D8;fontSize=11;" value="&lt;b&gt;Step 1.2  CREATOR_CONTRACT_ID Lookup&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Cancel and Rebook path. SELECT * FROM RDH_TRADE_LINEAGE WHERE MX_CONTRACT_ID = [creator_contract_id] AND REGIME = MIFID&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="710" y="610" as="geometry" />
        </mxCell>
