        <mxCell id="vOGihw5DsFz4zbwunT8B-11" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#555555;strokeColor=#999999;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ OBSOLETE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Retain CANC action. Create new record.&lt;/font&gt;" vertex="1">
          <mxGeometry height="180" width="300" x="220" y="450" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-12" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev OBSOLETE and&lt;br/&gt;not SENT?" vertex="1">
