          <mxGeometry height="80" width="130" x="680" y="980" as="geometry" />
        </mxCell>
        <mxCell id="s1211" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 1.2.1.1  NPF via Creator&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component] · Kear confirmed&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new row → RDH_TRADE_LINEAGE:&lt;br/&gt;  Same MIFID_LINK_ID. Update MX_CONTRACT_ID to&lt;br/&gt;  rebooked contract. Carry other linkage values.&lt;br/&gt;INSERT new row → RDH_PERSISTENCE:&lt;br/&gt;  Carry forward all existing persisted values.&lt;br/&gt;TRN: unchanged. MIFID_ACTION: NULL.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="290" x="410" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="s1212" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 1.2.1.2  PF / NRPT via Creator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new MIFID_LINK_ID. PARENT = creator row LINK_ID. MX_VERSION resets to 1. INSERT RDH_PERSISTENCE.&lt;/font&gt;" vertex="1">
          <mxGeometry height="155" width="220" x="910" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="s20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 2.0  Brand New Lineage&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component] · Kear confirmed&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;No CONTRACT_ID match. No CREATOR match.&lt;br/&gt;INSERT new row → RDH_TRADE_LINEAGE:&lt;br/&gt;  New MIFID_LINK_ID. PARENT = null (root).&lt;br/&gt;  ROOT_LINK_ID = this MIFID_LINK_ID.&lt;br/&gt;  TRN = MX_TRADE_NB (no suffix).&lt;br/&gt;INSERT new row → RDH_PERSISTENCE:&lt;br/&gt;  MIFID_STATUS = PENDING. MIFID_ACTION = NULL.&lt;/font&gt;" vertex="1">
          <mxGeometry height="230" width="157.5" x="992.5" y="727.5" as="geometry" />
        </mxCell>
