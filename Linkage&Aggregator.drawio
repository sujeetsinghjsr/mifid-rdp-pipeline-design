        <mxCell id="vOGihw5DsFz4zbwunT8B-15" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#000000;strokeColor=#b85450;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ FAIL (warning)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Trade currently in FAIL status. Create new record.&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="220" y="870" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-16" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#333333;strokeColor=#d6b656;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ No previous version found&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;No history for this TRN. Behaviour TBC — in practice this should not occur for a CANC action. Treat as open point.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="640" x="10" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-17" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev SENT and&lt;br/&gt;LATEST action&lt;br/&gt;NOT CANC?" vertex="1">
          <mxGeometry height="90" width="170" x="690" y="130" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-18" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#000000;strokeColor=#82b366;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ PENDING&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Retain REPL action. Override any prev PENDING to OBSOLETE. Create new record.&lt;br/&gt;Trade sent and not cancelled — REPL (Correction) now sent.&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="900" y="90" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-19" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev SENT and&lt;br/&gt;LATEST action&lt;br/&gt;= CANC?" vertex="1">
          <mxGeometry height="90" width="170" x="690" y="310" as="geometry" />
