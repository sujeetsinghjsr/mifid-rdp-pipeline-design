        <mxCell id="ddt" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=12;verticalAlign=middle;align=center;" value="DELTA_TYPE?&#xa;(From LCE payload.&#xa;Decides what to DO&#xa;with comparison result.&#xa;NOT which fields&#xa;to compare.)" vertex="1">
          <mxGeometry height="180" width="220" x="2510" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="odt_yf" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#000000;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;verticalAlign=middle;align=center;arcSize=20;" value="&lt;b&gt;→ YF: Full Delta — Report Out&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Decision rule:&lt;/b&gt; If ANY field changed&lt;br/&gt;(economic OR non-economic) → report out.&lt;br/&gt;No suppression based on field type.&lt;br/&gt;MIFID_ACTION = REPL (or NEWT if first).&lt;br/&gt;→ Proceed to Phase D.&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="220" x="2425" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="odt_ye" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#000000;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;verticalAlign=middle;align=center;" value="&lt;b&gt;→ YE: Economic Delta — Filter Result&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;&lt;b&gt;Decision rule:&lt;/b&gt; Check what changed:&lt;br&gt;ANY economic field changed → REPL → Phase D.&lt;br&gt;ONLY non-economic fields changed → SUPPRESS → STOP.&lt;br&gt;No delta at all → SUPPRESS → STOP.&lt;br&gt;Economic tags in static rules table (Action A7).&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: rgb(230, 81, 0);&quot;&gt;⚠ Field list: confirm with Kear + Den.&lt;/font&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="230" x="2680" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="odt_n" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#555555;strokeColor=#999999;strokeWidth=1;fontSize=12;verticalAlign=middle;align=center;" value="&lt;b&gt;→ N: No Delta Check&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;No comparison runs for this LCE event.&lt;br/&gt;Skip Check A and Check B entirely.&lt;br/&gt;Send directly to Phase D.&lt;br/&gt;No rows written to RDH_AUDIT_DELTA.&lt;/font&gt;" vertex="1">
          <mxGeometry height="145" width="140" x="2900" y="990" as="geometry" />
