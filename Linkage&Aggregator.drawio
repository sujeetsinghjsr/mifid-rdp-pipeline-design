        </mxCell>
        <mxCell id="s111" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 1.1.1  NPF Carry Forward&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component] · Kear call confirmed&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new row → RDH_TRADE_LINEAGE:&lt;br/&gt;  Same MIFID_LINK_ID + PARENT_LINK_ID carried.&lt;br/&gt;  Updated: event label, MESSAGE_ID, timestamp.&lt;br/&gt;INSERT new row → RDH_PERSISTENCE:&lt;br/&gt;  Carry forward all existing persisted values.&lt;br/&gt;TRN: unchanged. MIFID_ACTION: NULL.&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="290" x="250" y="920" as="geometry" />
        </mxCell>
        <mxCell id="s112" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#000000;fontSize=11;" value="&lt;b&gt;Step 1.1.2  PF / NRPT New Link&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;INSERT new MIFID_LINK_ID. PARENT = previous. New TRN = MX_TRADE_NB + V + MX_VERSION. IS_NRPT = Y if NRPT. MIFID_STATUS = PENDING. INSERT RDH_PERSISTENCE.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="510" y="765" as="geometry" />
        </mxCell>
        <mxCell id="s12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#85BBF0;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#78A8D8;fontSize=11;" value="&lt;b&gt;Step 1.2  CREATOR_CONTRACT_ID Lookup&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Component]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Cancel and Rebook path. SELECT * FROM RDH_TRADE_LINEAGE WHERE MX_CONTRACT_ID = [creator_contract_id] AND REGIME = MIFID&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="710" y="630" as="geometry" />
        </mxCell>
        <mxCell id="d12" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="Creator match?" vertex="1">
