        <mxCell id="p1_ye_sup" edge="1" parent="1" source="odt_n" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#1565C0;strokeWidth=1.5;fontColor=#1565C0;fontSize=9;dashed=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="osup" value="→ SUPPRESS&#xa;(non-econ only)">
          <mxGeometry relative="1" x="-0.8035" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="2935" y="1428" />
            </Array>
