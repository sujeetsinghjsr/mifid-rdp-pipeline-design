        <mxCell id="vOGihw5DsFz4zbwunT8B-13" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#555555;strokeColor=#999999;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ OBSOLETE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Retain CANC action. Create new record.&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="220" y="670" as="geometry" />
