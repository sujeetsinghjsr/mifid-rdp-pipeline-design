        </mxCell>
        <mxCell id="delta_logic_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;fontColor=#4A148C;strokeColor=#4A148C;strokeWidth=2;fontSize=9;verticalAlign=top;align=left;spacingLeft=5;" value="&lt;b&gt;⚡ PHASE C LOGIC — Kear confirmed&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Step 1: ALWAYS compare ALL fields&lt;br/&gt;(same process for YF and YE).&lt;br/&gt;Step 2: DELTA_TYPE decides outcome:&lt;br/&gt;  YF = any field changed → report out&lt;br/&gt;  YE = economic field changed → report&lt;br/&gt;        only non-economic → suppress&lt;br/&gt;  N  = skip comparison entirely&lt;br/&gt;DELTA_TYPE is NOT about WHICH fields&lt;br/&gt;to compare — it is about WHAT TO DO&lt;br/&gt;with the comparison result.&lt;/font&gt;" vertex="1">
          <mxGeometry height="220" width="130" x="1370" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="dqd" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=12;verticalAlign=middle;align=center;" value="(A) Qty Delta?&lt;br&gt;INT_RPT_QTY&lt;br&gt;≠ CURRENT_QTY?" vertex="1">
          <mxGeometry height="110" width="200" x="1670" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="oqd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#000000;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;verticalAlign=middle;align=center;arcSize=13;" value="&lt;b&gt;→ Quantity Delta Found&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Source: Kear DELTA_WF_FINAL&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;REPL, no prior DECR_INCR flag:&lt;/b&gt;&lt;br/&gt;Report CURRENT quantity as-is.&lt;br&gt;&lt;br&gt;&lt;b&gt;REPL, existing DECR_INCR flag:&lt;/b&gt;&lt;br/&gt;Continue reporting DELTA_QTY.&lt;br&gt;&lt;br&gt;&lt;b&gt;NEWT (amendment):&lt;/b&gt;&lt;br/&gt;Report change-in-quantity with&lt;br/&gt;DECR/INCR flag set." vertex="1">
          <mxGeometry height="195" width="240" x="1650" y="1455" as="geometry" />
        </mxCell>
        <mxCell id="dfd" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=12;verticalAlign=middle;align=center;" value="(B) Compare ALL&#xa;Reporting Fields&#xa;vs prev version&#xa;in MIFID_REPORTING&#xa;_TABLE via TRN&#xa;&#xa;Shared — YF + YE&#xa;Write 1 row per&#xa;field to AUDIT_DELTA" vertex="1">
          <mxGeometry height="185" width="285" x="2030" y="997.5" as="geometry" />
        </mxCell>
        <mxCell id="ofd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontColor=#000000;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;verticalAlign=middle;align=center;" value="&lt;b&gt;→ Field Delta Found&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Source: BRD 5.1 + Den §3+§4 + Kear call&lt;/font&gt;&lt;br&gt;&lt;b&gt;If economic field changed (tagged Y in rules table):&lt;/b&gt;&lt;br&gt;  MIFID_ACTION = REPL → Phase D&lt;br&gt;&lt;b&gt;If ONLY non-economic field changed (tagged N):&lt;/b&gt;&lt;br&gt;  MIFID_ACTION = SUPPRESS → STOP (YE only)&lt;br&gt;12 economic fields: F7,F16,F28,F33,F36,F41,F57,F59,&lt;br&gt;PriceCCY,Qty,NotionalAmt,NotionalCCY.&lt;br&gt;&lt;font style=&quot;font-size: 9px; color: rgb(230, 81, 0);&quot;&gt;⚠ Full list pending Kear confirmation&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="245" x="1960" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="osup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#555555;strokeColor=#999999;strokeWidth=1;fontSize=12;verticalAlign=middle;align=center;" value="&lt;b&gt;→ Suppress — No Economic Delta&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Source: Kear DELTA_WF_FINAL&lt;/font&gt;&lt;br&gt;No quantity delta AND no field delta.&lt;br/&gt;Exit trade — do NOT send to Trax. STOP." vertex="1">
          <mxGeometry height="115" width="180" x="2230" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="e_qdy" edge="1" parent="1" source="dqd" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#2D6A4F;strokeWidth=2;fontColor=#2D6A4F;fontSize=11;" target="oqd" value="YES → qty changed">
          <mxGeometry relative="1" x="0.2586" y="-15" as="geometry">
