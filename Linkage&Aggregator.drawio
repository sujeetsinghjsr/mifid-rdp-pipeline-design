        <mxCell id="ph_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85BBF0;fontColor=#000000;strokeColor=#78A8D8;strokeWidth=1;fontSize=12;verticalAlign=middle;align=center;" value="&lt;b&gt;[Aggregator] Phase A — Poll&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Source: BRD + Kear Persistance_Table&lt;/font&gt;&lt;br&gt;&lt;br&gt;SELECT * FROM RDH_PERSISTENCE&lt;br&gt;WHERE MIFID_STATUS=&#39;PENDING&#39; AND REGIME=&#39;MIFID&#39;&lt;br&gt;&lt;br&gt;SET MIFID_STATUS=&#39;READING&#39; (lock).&lt;br&gt;Fires before each Trax batch window." vertex="1">
