  <diagram id="cJdjhTWu_g-hB2dl12EM" name="Exgester WF Final">
    <mxGraphModel dx="2491" dy="1298" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="vOGihw5DsFz4zbwunT8B-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" value="&lt;b style=&quot;font-size:20px;&quot;&gt;EXGESTER_WF_FINAL — Phase D Submission State Logic&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#444444&quot; style=&quot;font-size:12px;&quot;&gt;Source: Kear EXGESTER_WF_FINAL (18 Jun 2026) + Team call (18 Jun 2026)  ·  ARM BATCH PROCESSING ONLY — APA follows real-time, this logic does not apply to APA  ·  Branches by current Reporting Action (CANC / REPL / NEWT), then checks LATEST previous action status against MIFID_REPORTING_TABLE in sequence&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="2100" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-2" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="1340" width="2080" x="60" y="80" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-3" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;fontColor=#ffffff;strokeColor=#8f4340;strokeWidth=1;fontSize=13;verticalAlign=middle;align=center;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Is Reporting Action = CANC?&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="640" x="10" y="10" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-4" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#54719c;strokeWidth=1;fontSize=13;verticalAlign=middle;align=center;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Is Reporting Action = REPL?&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="640" x="690" y="10" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-5" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;fontColor=#ffffff;strokeColor=#699250;strokeWidth=1;fontSize=13;verticalAlign=middle;align=center;" value="&lt;b style=&quot;font-size:13px;&quot;&gt;Is Reporting Action = NEWT?&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="640" x="1370" y="10" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-6" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev SENT and&lt;br/&gt;LATEST action&lt;br/&gt;NOT CANC?" vertex="1">
          <mxGeometry height="90" width="170" x="10" y="130" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-7" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#000000;strokeColor=#82b366;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ PENDING&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Retain CANC action. If any prev PENDING, override to OBSOLETE. Create new record.&lt;br/&gt;Trade was sent and latest action was not a cancel — CANC now sent.&lt;br/&gt;&lt;i&gt;(Check is against LATEST action only — team call confirmed.)&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="300" x="220" y="90" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-8" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev SENT and&lt;br/&gt;LATEST action&lt;br/&gt;= CANC?" vertex="1">
          <mxGeometry height="90" width="170" x="10" y="310" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-9" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontColor=#000000;strokeColor=#b85450;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ FAIL (warning)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Trade already submitted and previously cancelled (latest action = CANC).&lt;br/&gt;&lt;i&gt;⚠ Open: suppress in RDP or send to Trax for rejection? Discussed in team call, no firm decision. Team leaned toward suppressing in RDP.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="220" y="290" as="geometry" />
        </mxCell>
        <mxCell id="vOGihw5DsFz4zbwunT8B-10" parent="vOGihw5DsFz4zbwunT8B-2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;fontColor=#000000;strokeColor=#d6b656;strokeWidth=2;fontSize=11;verticalAlign=middle;align=center;" value="Prev PENDING and&lt;br/&gt;not SENT?" vertex="1">
