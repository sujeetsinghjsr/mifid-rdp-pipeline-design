        </mxCell>
        <mxCell id="d11" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontColor=#000000;fontSize=11;" value="Event category?" vertex="1">
