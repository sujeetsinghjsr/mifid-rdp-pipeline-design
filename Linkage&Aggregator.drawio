  <diagram id="p3" name="Trade Linkage">
    <mxGraphModel dx="2803" dy="1460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1430" math="0" shadow="0">
      <root>
