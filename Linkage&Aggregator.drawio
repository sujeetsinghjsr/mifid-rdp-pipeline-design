        <mxCell id="p1_oqd_fd" edge="1" parent="1" source="oqd" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#4A148C;strokeWidth=1.5;fontColor=#4A148C;fontSize=9;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="dfd" value="→ (B) Field&#xa;Comparison">
