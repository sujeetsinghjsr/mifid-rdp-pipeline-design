        <mxCell id="ti" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" value="&lt;b style=&quot;font-size:17px;&quot;&gt;Stage 2 — Trade Linkage Decision Logic&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size: 11px;&quot;&gt;Component Diagram  ·  BRD Section 5  ·  Kear&#39;s Table_Structure&amp;nbsp;&lt;/font&gt;" vertex="1">
          <mxGeometry height="46" width="920" x="30" y="18" as="geometry" />
        </mxCell>
        <mxCell id="kin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#8A8A8A;fontSize=11;" value="&lt;b&gt;Kafka Message&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[Input]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;MESSAGE_ID · CONTRACT_ID · CREATOR_CONTRACT_ID · MX_VERSION · MIFID_EVENT_CATEGORY (PF/NPF/NRPT)&lt;/font&gt;" vertex="1">
