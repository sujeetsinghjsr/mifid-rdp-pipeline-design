        <mxCell id="vOGihw5DsFz4zbwunT8B-40" parent="vOGihw5DsFz4zbwunT8B-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontColor=#000000;strokeColor=#82b366;strokeWidth=1;fontSize=11;verticalAlign=middle;align=center;" value="&lt;b&gt;→ PENDING — first instance&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Retain NEWT action. Create new record. No previous version found in MIFID_REPORTING_TABLE at all.&lt;br/&gt;&lt;i&gt;⚡ Suppressed/no-delta trades are never in this table, so this is the genuine first reportable version.&lt;/i&gt;&lt;/font&gt;" vertex="1">
