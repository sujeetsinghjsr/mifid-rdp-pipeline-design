        <mxCell id="ed12n" edge="1" parent="1" source="d12" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;strokeColor=#707070;strokeWidth=2;fontColor=#707070;fontSize=10;" target="s20" value="NO → brand new">
