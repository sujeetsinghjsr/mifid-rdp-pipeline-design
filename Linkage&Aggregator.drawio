        <mxCell id="edb20a" edge="1" parent="1" source="s20" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;orthogonalLoop=1;jettySize=auto;dashed=1;strokeColor=#aaaaaa;strokeWidth=1;fontColor=#888888;fontSize=9;" target="dtl_o" value="INSERT">
          <mxGeometry relative="1" as="geometry" />
