        </mxCell>
        <mxCell id="trx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#999999;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#8A8A8A;fontSize=11;" value="&lt;b&gt;Trax&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[External ARM / APA]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Receives CSV reports. Returns AACK / AREJ / RACK / RREJ.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="160" x="1470" y="210" as="geometry" />
        </mxCell>
        <mxCell id="brd" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=1 2;fontColor=#666666;labelBackgroundColor=none;align=left;verticalAlign=top;fontStyle=1;fontSize=12;" value="RDH — Regulatory Data Hub  (schema: rdh_core)" vertex="1">
          <mxGeometry height="450" width="1220" x="240" y="120" as="geometry" />
        </mxCell>
        <mxCell id="s0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;fontSize=11;" value="&lt;b&gt;Step 0 Replay Check&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Container] · Kear call confirmed&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Checks MESSAGE_ID before any logic runs.&lt;br/&gt;If found: INSERT new row in both tables&lt;br/&gt;with REPLAY_FLAG=Y, carry same LINK_ID.&lt;br/&gt;Skip Steps 1.0 → 2.0.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="270" y="210" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#1168BD;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#ffffff;strokeWidth=3;fontSize=11;" value="&lt;b&gt;Stage 2 Trade Linkage  ★&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Container  IN SCOPE]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;CONTRACT_ID lookup. Creates / carries MIFID_LINK_ID. Sets TRN, IS_NRPT, MIFID_STATUS=PENDING.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="470" y="210" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;fontSize=11;" value="&lt;b&gt;Stage 3 Delta Check&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Container]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Compares ALL reporting fields between versions. Sets MIFID_ACTION: NEWT / REPL / CANC.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="670" y="210" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;fontSize=11;" value="&lt;b&gt;Stage 6 Field Enrichment&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Container]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Derives IDM (F57), EDM (F59), MIC / Venue (F36), ISIN (F41). Updates Persistence.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="870" y="210" as="geometry" />
        </mxCell>
        <mxCell id="s7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;fontSize=11;" value="&lt;b&gt;Stage 7 Report Build&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Container]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Builds ARM CSV. Suppresses IS_NRPT=Y and IS_PREMIFID=Y records.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="1070" y="210" as="geometry" />
        </mxCell>
        <mxCell id="s8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#3C7FC0;fontSize=11;" value="&lt;b&gt;Stage 8 Trax Submission&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[RDH Container]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Submits in 2 batches: 07:30 and 18:00 AEST. Persists TRAX responses.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="1270" y="210" as="geometry" />
        </mxCell>
        <mxCell id="dtl" parent="1" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#438DD5;fontColor=#ffffff;strokeColor=#3C7FC0;align=center;fontSize=11;" value="&lt;b&gt;RDH_TRADE_LINEAGE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;[PostgreSQL Table]&lt;/font&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;MIFID_LINK_ID, Parent, TRN, IS_NRPT, IS_PREMIFID, MESSAGE_ID, MIFID_STATUS&lt;/font&gt;" vertex="1">
